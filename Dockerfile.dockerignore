# 构建上下文过滤（配合仓库根目录的 Dockerfile 使用）
# 只把应用源码送进构建上下文：去掉本地依赖、构建产物与敏感文件。
# 说明：BuildKit / docker buildx 优先使用 Dockerfile.dockerignore；
#       本文件与其内容保持一致，以便旧构建器行为相同。
#       无前导斜杠的模式锚定在上下文根目录（如 storage/ 不会匹配 plugins/x/storage/）。

# --- 版本控制 / CI / 编辑器 ---
.git/
.github/
.gitpod.yml
.devcontainer/
.husky/
.agent-teams/
.vscode/
.idea/

# --- 本地依赖与构建产物（镜像内重新生成） ---
node_modules/
vendor/
public/app/
public/lang/
public/plugins/
resources/views/assets/
resources/views/overrides/
resources/assets/tests/
storage/
bootstrap/cache/
dist/

# --- 文档 / 架构图 / 测试 ---
docs/
normify-blessing-skin-server/
PROJECT_MEMORY.md
README.md
README-zh.md
tests/
phpunit.xml

# --- 配置与密钥（绝不进镜像） ---
.env
.env.testing
deploy.env
database/*.sqlite
database/*.db
storage/*.key

# --- 杂项 ---
.editorconfig
.eslintignore
.eslintrc.yml
.php-cs-fixer.cache
.php-cs-fixer.dist.php
.phpunit.result.cache
junit.xml
_ide_helper.php
yarn-error.log
crowdin.yml
index.html
*.tar
*.tar.gz
*.log
