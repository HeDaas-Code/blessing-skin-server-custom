{% extends 'user.base' %}

{% block title %}{{ trans('Yggdrasil::binding.title') }}{% endblock %}

{% block content %}
  <div class="row">
    <div class="col-md-8">
      <div class="card card-success card-outline">
        <div class="card-header">
          <h3 class="card-title">{{ trans('Yggdrasil::binding.title') }}</h3>
        </div>
        <div class="card-body">
          {% if errors.any() %}
            <div class="alert alert-danger">
              {% for error in errors.all() %}<p class="mb-0">{{ error }}</p>{% endfor %}
            </div>
          {% endif %}

          {% if session('status') %}
            <div class="alert alert-success">{{ session('status') }}</div>
          {% endif %}

          {% if conflict %}
            <div class="alert alert-warning">
              {{ trans('Yggdrasil::binding.conflict-intro', {'name': conflict.official}) }}
              <a class="btn btn-sm btn-warning ml-2" href="{{ url('user/yggdrasil-binding/resolve') }}">{{ trans('Yggdrasil::binding.conflict-resolve') }}</a>
            </div>
          {% endif %}

          {% if binding %}
            <table class="table">
              <tbody>
                <tr><th>{{ trans('Yggdrasil::binding.player-name') }}</th><td>{{ binding.player_name }}</td></tr>
                <tr><th>UUID</th><td><code>{{ binding.mojang_uuid }}</code></td></tr>
                <tr><th>{{ trans('Yggdrasil::binding.bound-at') }}</th><td>{{ binding.bound_at }}</td></tr>
              </tbody>
            </table>
            <form method="post" action="{{ url('user/yggdrasil-binding/sync') }}" class="d-inline">
              {{ csrf_field() }}
              <button type="submit" class="btn btn-success">{{ trans('Yggdrasil::binding.sync') }}</button>
            </form>
            <form method="post" action="{{ url('user/yggdrasil-binding/unbind') }}" class="d-inline" onsubmit="return confirm('{{ trans('Yggdrasil::binding.confirm-unbind') }}')">
              {{ csrf_field() }}
              <button type="submit" class="btn btn-danger">{{ trans('Yggdrasil::binding.unbind') }}</button>
            </form>
          {% else %}
            <p>{{ trans('Yggdrasil::binding.intro') }}</p>
            {% if auth_method == 'device_code' %}
              <form method="post" action="{{ url('user/yggdrasil-binding/device/start') }}">
                {{ csrf_field() }}
                <button type="submit" class="btn btn-primary">{{ trans('Yggdrasil::binding.bind-device') }}</button>
              </form>
            {% else %}
              <a class="btn btn-primary" href="{{ url('user/yggdrasil-binding/redirect') }}">{{ trans('Yggdrasil::binding.bind') }}</a>
            {% endif %}
          {% endif %}
        </div>
      </div>
    </div>
  </div>
{% endblock %}
