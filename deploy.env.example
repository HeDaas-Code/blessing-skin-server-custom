# 一键部署配置：复制为 deploy.env 后按需修改（该文件已被 .gitignore 忽略，不会进版本库）
#
# 注意：Docker Compose 会解析本文件中的 $ 符号。
#       密码里含 $ 时请写成 $$（例如 Abc$$123），或用单引号包裹整个值（例如 BS_ADMIN_PASSWORD='Abc$123'）。

# =============== 必填：超级管理员（仅首次启动创建） ===============
BS_ADMIN_EMAIL=admin@example.com
BS_ADMIN_PASSWORD=change-me-please
BS_ADMIN_NICKNAME=admin

# =============== 站点 ===============
# 对外端口（宿主机 -> 容器 80）
BS_PORT=8080
# 站点名称与地址（不填则分别为 "Blessing Skin" 和自动探测的访问地址）
BS_SITE_NAME=我的皮肤站
# BS_SITE_URL=https://skin.example.com
# 时区
TZ=Asia/Shanghai

# =============== 数据库 ===============
# 默认 SQLite，零依赖，数据存放在 storage 卷中
DB_CONNECTION=sqlite
DB_DATABASE=/app/storage/database.db

# 使用 MySQL：启动命令改为
#   docker compose --env-file deploy.env --profile mysql up -d
# 并启用下面几行（DB_HOST 必须是 mysql，即 compose 中的服务名）
# DB_CONNECTION=mysql
# DB_DATABASE=blessingskin
# DB_HOST=mysql
# DB_PORT=3306
# DB_USERNAME=blessing
# DB_PASSWORD=blessing
# DB_ROOT_PASSWORD=root

# =============== 插件 ===============
# 留空 = 自动启用镜像内置的全部插件；也可只启用部分，例如：
# BS_PLUGINS=yggdrasil-api
YGG_VERBOSE_LOG=false

# =============== 邮件（可选，用于找回密码） ===============
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=465
# MAIL_USERNAME=skin@example.com
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=ssl
# MAIL_FROM_ADDRESS=skin@example.com
# MAIL_FROM_NAME=我的皮肤站

# =============== 其它 ===============
# 也可直接传入 PHP 配置项，例如启用调试：
# APP_DEBUG=true
# 会话有效期（分钟）
# SESSION_LIFETIME=120
